# AgroVax API - variaveis de ambiente
# Copie para ".env" e preencha. NUNCA versione o arquivo .env.

NODE_ENV=development
PORT=3333

# PostgreSQL. O valor abaixo aponta para o banco embarcado de desenvolvimento
# (iniciado com "npm run db:dev"). Em producao, use a URL do banco gerenciado.
DATABASE_URL="postgresql://agrovax@localhost:5433/agrovax?schema=public"

# Segredo de assinatura dos tokens de acesso (minimo de 32 caracteres).
# Gere um valor proprio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Validade dos tokens.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=90

# Origens de navegador permitidas (CORS), separadas por virgula.
# O app mobile nao precisa disso; deixe vazio se nao houver painel web.
CORS_ORIGINS=

# Quantidade de proxies confiaveis a frente da API (ex.: 1 na maioria das hospedagens).
TRUST_PROXY=0

LOG_LEVEL=info

# E-mail (codigo de recuperacao de senha). Obrigatorio em producao.
# Em desenvolvimento, sem SMTP_HOST, o e-mail e apenas escrito no log da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AgroVax <nao-responda@agrovax.app>"

# Vigilancia sanitaria: endereco de um feed JSON de alertas (opcional).
# Sem este valor, nenhuma fonte externa e consultada e o app mostra apenas
# os alertas cadastrados pelo administrador (ou os DEMO do seed).
SURVEILLANCE_FEED_URL=

# Senha do usuario demo criado pelo seed (demo@agrovax.app).
# Se vazio, o seed gera uma senha aleatoria e a exibe no terminal.
SEED_DEMO_PASSWORD=

# Portas do PostgreSQL embarcado (desenvolvimento e testes).
DEV_DB_PORT=5433
TEST_DB_PORT=5434
