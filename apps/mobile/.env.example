# AgroVax mobile - variaveis de ambiente
# Copie para ".env". Variaveis EXPO_PUBLIC_* sao embutidas no app e, portanto,
# publicas: nunca coloque segredos aqui.

# Endereco da API (sem barra no final).
#   Emulador Android:  http://10.0.2.2:3333
#   Simulador iOS:     http://localhost:3333
#   Celular fisico:    http://<IP-da-sua-maquina-na-rede>:3333
#   Producao:          https://api.seudominio.com.br
EXPO_PUBLIC_API_URL=http://10.0.2.2:3333
